+          "content": "name: NEZHA-CLOUD-CONTINUOUS-LOOP\n\n# 今晚唯一一条云起搏（原 NEZHA-CLOUD-AUTO-TAKEOVER 已改写为本循环）。\n#\n# 目的：把本地 1WB 后腿的「自主工作循环」搬到云肉身 ——\n#   每一拍：读 STATE → 分类（RUNNING / LOCAL_HELD 不抢活 / TAKEOVER / IDLE 扫描 / GENUINE_IDLE）\n#          → 只做一个动作 → 写 heartbeat(round_seq+1)\n# 第五到十分钟的调度延迟是 GitHub 的常态，**准点不是 PASS 条件**；\n# PASS 条件是：黑武士关机以后，下一拍仍然由这里自己发生。\non:\n  workflow_dispatch:\n    inputs:\n      diag:\n        description: \"true = diagnostic scan only (no task created, no state change)\"\n        required: false\n        default: \"false\"\n  schedule:\n    - cron: \"*/5 * * * *\"\n\nconcurrency:\n  group: nezha-cloud-executor   # 与原 concurrent 组同名：保证同一时刻只有一个被执行，绝不双跑\n  cancel-in-progress: false\n\npermissions:\n  contents: write\n  actions: write        # 允许云端自己 dispatch 下一拍（自延续链）\n\nenv:\n  NEZHA_SELF_SCHEDULE: \"1\"\n\njobs:\n  loop:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v4\n\n      - name: Setup Python\n        uses: actions/setup-python@v5\n        with:\n          python-version: \"3.11\"\n\n      - name: One beat of NEZHA continuous loop\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          NEZHA_AUTH_ID: KR-TOKEN-20260928-POWEROFF-V2\n          NEZHA_STALE_SEC: \"900\"   # LOCAL 不再有常驻心跳：最后一吻时间戳 + 15 分钟窗口，\n                                   # KR 须在冻结后 15 分钟内物理关机，接管必然晚于关机\n        run: |\n          echo \"run_id=$GITHUB_RUN_ID attempt=$GITHUB_RUN_ATTEMPT started=$(date -u +%FT%TZ)\"\n          if [ \"${{ inputs.diag }}\" = \"true\" ]; then\n            echo \"mode=diagnose\"\n            python .wb1/nezha/loop.py --diagnose\n          else\n            python .wb1/nezha/loop.py\n          fi\n          echo \"exit=$?\"\n\n      # 墨子云端巡检（5分钟同拍）：只读两条腿生命与业务推进，不替哪吒决定战争。\n      # 目的：KR 要求墨子按 5 分钟节拍盯「有没有持续产 REAL」，而不是盯 PID/定时器/HTTP200。\n      # mozi.yml 无 cron 自触发能力（本仓库 schedule 历史 0 条），故挂在自起拍链同拍执行。\n      - name: MOZI patrol (read-only)\n        if: always()\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: |\n          python .wb1/nezha/mozi_watch.py\n          echo \"moziexit=$?\"\n\n      # 云自起拍：睡到下一个 5 分钟边界后由**本 runner 自己** dispatch 下一拍。\n      # 用途：GitHub 原生 schedule cron 在本仓库实测长期不自行触发（event=schedule 历史 0 条），\n      # 这是减损链。第一推动力在黑武士关机前搬一次，此后每一拍的发起都由云端自己完成。\n      - name: Cloud self-schedules next beat\n        if: always()\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          NEZHA_SELF_SCHEDULE: \"1\"\n          NEZHA_BEAT_MIN: \"5\"\n          NEZHA_MAX_BEATS: \"240\"\n        run: |\n          python .wb1/nezha/loop.py --wait-and-schedule\n          echo \"nextexit=$?\"\n",
