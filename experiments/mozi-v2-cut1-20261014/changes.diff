+                raise Hold('API redirect rejected')
+        with urllib.request.build_opener(NoRedirect()).open(req, timeout=20) as response:
+            if response.geturl() != API_BASE + path:
+                raise Hold('untrusted API endpoint')
+            return json.load(response)
+
