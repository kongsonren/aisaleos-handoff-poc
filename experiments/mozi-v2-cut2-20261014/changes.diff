+
+    def publish(self, result, api):
+        """Durable at-most-once POST; ambiguity is HOLD, never blind retry."""
+        if result.get('status') == 'DUPLICATE':
+            result = result['result']
+        if result.get('status') != 'PASS':
+            return result
